---
interface Props {
  featureId: string;
}

const { featureId } = Astro.props;

const eqHeights = [44, 86, 58, 96, 50, 82, 68, 92, 54, 76];
---

<div
  class="relative w-full min-h-[246px] sm:min-h-[258px] rounded-2xl bg-[#00142E] border border-[#193C70]/90 p-3.5 sm:p-4 flex flex-col justify-between overflow-hidden select-none mb-6"
  aria-hidden="true"
  data-testid={`feature-art-${featureId}`}
>
  {featureId === 'portfolio' && (
    <div class="flex flex-col justify-between h-full gap-2.5">
      {/* Mini App Window Bar */}
      <div class="flex items-center justify-between gap-2 pb-2 border-b border-[#193C70]/85">
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-6 h-6 rounded-full bg-[#5D0E41] border border-[#FF204E]/80 flex items-center justify-center font-accent text-[10px] text-white shrink-0">
            KM
          </div>
          <span class="text-[11px] tracking-[0.03em] text-[#E2ECFA] truncate">
            tunetactics.ir / @kianmercer
          </span>
        </div>
        <span class="rounded-full bg-[#FF204E]/20 border border-[#FF204E]/70 px-2.5 py-0.5 text-[10px] text-[#FF6B8A] shrink-0">
          Open to collabs
        </span>
      </div>

      {/* Embedded Multi-Platform Track Card (Playing State) */}
      <div class="tt-feat-float-slow rounded-xl bg-[#00224D] border border-[#A0153E]/80 p-3">
        <div class="flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-full bg-[#FF204E] flex items-center justify-center shrink-0 shadow-[0_4px_14px_-2px_rgba(255,32,78,0.7)]">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                <rect x="2" y="2" width="2.8" height="8" rx="1" fill="#FFFFFF" />
                <rect x="7.2" y="2" width="2.8" height="8" rx="1" fill="#FFFFFF" />
              </svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs text-[#F4F7FC] truncate">Midnight Tape (WIP)</p>
              <p class="text-[10px] text-[#9FB4D1] truncate">SoundCloud Embed · 94 BPM · F Minor</p>
            </div>
          </div>

          <div class="flex items-end gap-[2.5px] h-4 shrink-0">
            {eqHeights.slice(0, 6).map((height, idx) => (
              <span
                class="tt-eq-bar w-[2.5px] rounded-full bg-[#FF204E]"
                style={`height: ${Math.round((height / 100) * 15)}px; --eq-delay: ${idx * 105}ms;`}
              />
            ))}
          </div>
        </div>

        {/* Live Animated Scrub Bar */}
        <div class="mt-2.5 flex items-center gap-2">
          <span class="text-[10px] text-[#FF6B8A] tabular-nums shrink-0">0:24</span>
          <div class="h-1.5 flex-1 rounded-full bg-[#00142E] overflow-hidden">
            <div class="tt-feat-progress h-full w-full rounded-full bg-[#FF204E]" />
          </div>
          <span class="text-[10px] text-[#8DA7CB] tabular-nums shrink-0">1:48</span>
        </div>
      </div>

      {/* Interactive Profile Chips: Gear, Skills & External Links */}
      <div class="grid grid-cols-2 gap-2 text-[10px]">
        <div class="rounded-xl bg-[#001B3E] border border-[#193C70]/85 px-2.5 py-2 flex items-center justify-between gap-1.5">
          <div class="min-w-0">
            <p class="text-[#8DA7CB] truncate">Studio Gear</p>
            <p class="text-[#E2ECFA] truncate mt-0.5">Prophet-6 · Ableton</p>
          </div>
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF204E] shrink-0" />
        </div>
        <div class="rounded-xl bg-[#001B3E] border border-[#5D0E41]/85 px-2.5 py-2 flex items-center justify-between gap-1.5">
          <div class="min-w-0">
            <p class="text-[#8DA7CB] truncate">Linked Catalog</p>
            <p class="text-[#FF6B8A] truncate mt-0.5">Spotify · Bandcamp</p>
          </div>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="text-[#FF5C7D] shrink-0">
            <path d="M3.5 8.5L8.5 3.5M8.5 3.5H4.5M8.5 3.5V7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>
  )}

  {featureId === 'discovery' && (
    <div class="flex flex-col justify-between h-full gap-2.5">
      {/* Top Search & Active Filter Toolbar */}
      <div class="space-y-2">
        <div class="flex items-center justify-between gap-2 rounded-xl bg-[#001B3E] border border-[#193C70]/90 px-3 py-1.5">
          <div class="flex items-center gap-2 min-w-0">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" class="text-[#FF5C7D] shrink-0">
              <circle cx="7" cy="7" r="4.8" stroke="currentColor" stroke-width="1.5" />
              <path d="M10.8 10.8L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span class="text-[11px] text-[#E2ECFA] truncate">
              Singer · Alt-R&amp;B · Remote
            </span>
          </div>
          <span class="text-[10px] text-[#FF6B8A] tabular-nums shrink-0">12 ready</span>
        </div>

        {/* Filter Chips Row with Animated Active Highlight */}
        <div class="flex items-center gap-1.5 overflow-hidden text-[10px]">
          <span class="rounded-full bg-[#FF204E] text-white px-2.5 py-0.5 whitespace-nowrap">
            Role: Singer
          </span>
          <span class="tt-ui-chip-pulse rounded-full bg-[#5D0E41]/75 border border-[#FF204E]/65 text-[#F4F7FC] px-2.5 py-0.5 whitespace-nowrap">
            Intent: Collabs
          </span>
          <span class="rounded-full bg-[#00224D] border border-[#193C70] text-[#9FB4D1] px-2.5 py-0.5 whitespace-nowrap">
            London / Remote
          </span>
        </div>
      </div>

      {/* Live Filtered Result Rows */}
      <div class="space-y-2 flex-1 flex flex-col justify-end">
        <div class="tt-hub-row-1 rounded-xl bg-[#00224D] border border-[#FF204E]/75 px-3 py-2 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-full bg-[#FF204E] flex items-center justify-center font-accent text-[11px] text-white shrink-0">
              NV
            </div>
            <div class="min-w-0">
              <p class="text-xs text-[#F4F7FC] truncate">Nora Vance · Singer</p>
              <p class="text-[10px] text-[#FF6B8A] truncate">Wants dark synth beats · Stems ready</p>
            </div>
          </div>
          <span class="rounded-full bg-[#FF204E] text-white px-2.5 py-1 text-[10px] shrink-0">
            Connect
          </span>
        </div>

        <div class="tt-hub-row-2 rounded-xl bg-[#001B3E] border border-[#5D0E41]/90 px-3 py-2 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-full bg-[#5D0E41] border border-[#A0153E] flex items-center justify-center font-accent text-[11px] text-white shrink-0">
              ML
            </div>
            <div class="min-w-0">
              <p class="text-xs text-[#E2ECFA] truncate">Maya Lin · Alt-R&amp;B</p>
              <p class="text-[10px] text-[#9FB4D1] truncate">Looking for heavy drums &amp; sub</p>
            </div>
          </div>
          <span class="rounded-full bg-[#00224D] border border-[#A0153E] text-[#E2ECFA] px-2.5 py-1 text-[10px] shrink-0">
            Audition
          </span>
        </div>
      </div>
    </div>
  )}

  {featureId === 'reels' && (
    <div class="grid grid-cols-12 gap-2.5 h-full items-stretch">
      {/* Left: Vertical Video/Audio Reel Player Frame */}
      <div class="col-span-5 rounded-xl bg-gradient-to-b from-[#5D0E41]/60 via-[#00224D] to-[#00142E] border border-[#FF204E]/70 p-2.5 flex flex-col justify-between">
        <div class="flex items-center justify-between gap-1">
          <span class="text-[10px] text-[#F4F7FC] truncate">@mayalin</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF204E]" />
        </div>

        <div class="my-auto flex flex-col items-center gap-2 py-2">
          <div class="tt-feat-blip-1 w-9 h-9 rounded-full bg-[#FF204E] flex items-center justify-center shadow-[0_4px_16px_-2px_rgba(255,32,78,0.75)]">
            <svg width="11" height="12" viewBox="0 0 11 12" fill="none" class="ml-0.5">
              <path d="M1.5 1.5L9.5 6L1.5 10.5V1.5Z" fill="#FFFFFF" />
            </svg>
          </div>
          <p class="text-[10px] text-center text-[#E2ECFA] leading-tight">
            Chorus hook · 112 BPM
          </p>
        </div>

        <div class="space-y-1.5">
          <div class="h-1 w-full rounded-full bg-[#001633] overflow-hidden">
            <div class="tt-feat-progress h-full w-full rounded-full bg-[#FF204E]" />
          </div>
          <div class="rounded-full bg-[#FF204E] text-white text-center py-1 text-[10px]">
            + Drop stem
          </div>
        </div>
      </div>

      {/* Right: Layered Stem Replies Stack */}
      <div class="col-span-7 flex flex-col justify-between gap-1.5">
        <div class="flex items-center justify-between text-[10px] px-0.5">
          <span class="text-[#9FB4D1]">Live stem layers</span>
          <span class="text-[#FF6B8A] tabular-nums">3 synced</span>
        </div>

        <div class="rounded-xl bg-[#00224D] border border-[#193C70] px-2.5 py-2 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-[11px] text-[#F4F7FC] truncate">1. Lead Vocal</p>
            <p class="text-[10px] text-[#9FB4D1] truncate">@mayalin · Original</p>
          </div>
          <div class="flex items-end gap-[2px] h-3.5 shrink-0">
            {eqHeights.slice(0, 5).map((height, idx) => (
              <span
                class="tt-eq-bar w-[2px] rounded-full bg-[#E2ECFA]"
                style={`height: ${Math.round((height / 100) * 13)}px; --eq-delay: ${idx * 100}ms;`}
              />
            ))}
          </div>
        </div>

        <div class="tt-ui-stem-layer rounded-xl bg-[#5D0E41]/45 border border-[#FF204E]/75 px-2.5 py-2 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-[11px] text-white truncate">2. + Pocket Drums</p>
            <p class="text-[10px] text-[#FF859D] truncate">@dante_beats · Stem reply</p>
          </div>
          <div class="flex items-end gap-[2px] h-3.5 shrink-0">
            {eqHeights.slice(4, 9).map((height, idx) => (
              <span
                class="tt-eq-bar w-[2px] rounded-full bg-[#FF204E]"
                style={`height: ${Math.round((height / 100) * 13)}px; --eq-delay: ${idx * 90}ms;`}
              />
            ))}
          </div>
        </div>

        <div class="rounded-xl bg-[#001B3E] border border-[#A0153E]/65 px-2.5 py-2 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <p class="text-[11px] text-[#E2ECFA] truncate">3. + Sub Bass</p>
            <p class="text-[10px] text-[#9FB4D1] truncate">@kianmercer · Synced</p>
          </div>
          <span class="rounded-full bg-[#00224D] border border-[#FF204E]/60 px-2 py-0.5 text-[9px] text-[#FF6B8A] shrink-0">
            Active
          </span>
        </div>
      </div>
    </div>
  )}

  {featureId === 'connect' && (
    <div class="flex flex-col justify-between h-full gap-2">
      {/* Studio Thread Header */}
      <div class="flex items-center justify-between gap-2 pb-2 border-b border-[#193C70]/85">
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 rounded-full bg-[#FF204E] shrink-0" />
          <p class="text-[11px] text-[#F4F7FC] truncate">
            Studio Thread · Kian &amp; Nora
          </p>
        </div>
        <span class="text-[10px] text-[#9FB4D1] shrink-0">Direct · No DMs lost</span>
      </div>

      {/* Chat & Stem File Exchange Messages */}
      <div class="space-y-2 flex-1 flex flex-col justify-center">
        {/* Outgoing Message + Beat Attachment */}
        <div class="self-start max-w-[88%] rounded-xl rounded-tl-sm bg-[#00224D] border border-[#193C70] px-2.5 py-2">
          <p class="text-[11px] text-[#E2ECFA] leading-snug">
            Chorus opens at 0:32 — ready for your vocal take.
          </p>
          <div class="mt-1.5 flex items-center gap-2 rounded-lg bg-[#00142E] px-2 py-1">
            <span class="w-4 h-4 rounded-full bg-[#FF204E] flex items-center justify-center shrink-0">
              <svg width="7" height="7" viewBox="0 0 8 8" fill="none">
                <path d="M2 1.5L6.5 4L2 6.5V1.5Z" fill="#FFFFFF" />
              </svg>
            </span>
            <span class="text-[10px] text-[#9FB4D1] truncate">Midnight_Hook_94bpm.wav</span>
          </div>
        </div>

        {/* Incoming Animated Reply + Vocal Stem Attachment */}
        <div class="tt-ui-reply-slide self-end max-w-[90%] rounded-xl rounded-tr-sm bg-[#5D0E41]/60 border border-[#FF204E]/70 px-2.5 py-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] text-[#FF859D]">@noravance</span>
            <span class="text-[9px] text-[#D6E2F5]">Just now</span>
          </div>
          <p class="text-[11px] text-white leading-snug mt-0.5">
            Recorded 2 takes! Dropping dry + harmony stems.
          </p>
          <div class="mt-1.5 flex items-center justify-between gap-2 rounded-lg bg-[#001633]/90 px-2 py-1">
            <span class="text-[10px] text-[#F4F7FC] truncate">Nora_Chorus_Stems.zip</span>
            <span class="text-[9px] text-[#FF6B8A] shrink-0">Synced ✓</span>
          </div>
        </div>
      </div>

      {/* Bottom Studio Message Composer */}
      <div class="rounded-full bg-[#001B3E] border border-[#193C70]/90 pl-3 pr-1.5 py-1 flex items-center justify-between gap-2">
        <span class="text-[10px] text-[#8DA7CB] truncate">
          Reply or attach WAV stems...
        </span>
        <span class="tt-ui-send-pulse rounded-full bg-[#FF204E] text-white px-2.5 py-0.5 text-[10px] shrink-0">
          Send
        </span>
      </div>
    </div>
  )}
</div>
