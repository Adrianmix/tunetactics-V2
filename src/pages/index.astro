---
import Layout from '../layouts/Layout.astro';
import HeroVisualizer from '../components/HeroVisualizer';
import ProductPreview from '../components/ProductPreview';
import WaitlistForm from '../components/WaitlistForm';
import FaqAccordion from '../components/FaqAccordion';
import FooterLinks from '../components/FooterLinks';
import HowItWorksScenes from '../components/HowItWorksScenes.astro';
import { STUDIO_ASSETS } from '../data/assets';
import { SITE_CONTENT } from '../data/content';
---

<Layout>
  <!-- Subtle Desktop Trailing Cursor Glow -->
  <div id="cursor-glow" class="tt-cursor-glow" aria-hidden="true"></div>

  <div class="relative z-10 min-h-screen flex flex-col">
    <!-- Top Bar Contract: 3 zones (Wordmark — Nav links — 1 Primary CTA) -->
    <header class="sticky top-0 z-40 bg-[#09090B]/95 border-b border-zinc-800/80">
      <!-- Scroll Progress Indicator -->
      <div
        data-scroll-progress
        aria-hidden="true"
        class="absolute top-0 left-0 right-0 h-[2px] bg-[#C8FF00] origin-left"
        style="transform: scaleX(0);"
      />

      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-8">
        <!-- Zone 1: Brand Wordmark -->
        <a
          href="#"
          class="inline-flex items-center gap-2.5 text-xl font-bold tracking-tight text-zinc-50 whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C8FF00] rounded-full"
          style="font-family: var(--font-display);"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
            class="shrink-0"
          >
            <rect x="2" y="7" width="3" height="6" rx="1.5" fill="#C8FF00" />
            <rect x="7" y="3" width="3" height="14" rx="1.5" fill="#C8FF00" />
            <rect x="12" y="5" width="3" height="10" rx="1.5" fill="#F4F4F5" />
            <rect x="17" y="8" width="2" height="4" rx="1" fill="#71717A" />
          </svg>
          <span>{SITE_CONTENT.nav.brand}</span>
        </a>

        <!-- Zone 2: Concise Single-Line Nav Links -->
        <nav aria-label="Primary" class="hidden md:flex items-center gap-8 text-base font-medium text-zinc-300">
          {SITE_CONTENT.nav.links.map((link) => (
            <a
              href={link.href}
              class="tt-nav-link hover:text-zinc-50 whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C8FF00] rounded-full"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Zone 3: 1 Primary Action -->
        <div class="shrink-0">
          <a
            href={SITE_CONTENT.nav.ctaHref}
            class="tt-btn inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#C8FF00] text-zinc-950 text-sm sm:text-base font-semibold hover:bg-[#D8FF42] whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C8FF00]"
          >
            {SITE_CONTENT.nav.ctaLabel}
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <!-- Hero Section -->
      <section class="pt-12 pb-16 sm:pt-16 sm:pb-24 px-4 sm:px-6 overflow-hidden">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-6">
            <h1
              class="tt-hero-stagger text-5xl sm:text-6xl lg:text-[4rem] font-bold tracking-tight text-zinc-50 leading-[1.05]"
              style="--stagger-delay: 0ms;"
            >
              {SITE_CONTENT.hero.headline}
            </h1>
            <p
              class="tt-hero-stagger mt-6 text-xl sm:text-2xl text-zinc-300 leading-relaxed max-w-xl"
              style="--stagger-delay: 90ms;"
            >
              {SITE_CONTENT.hero.subheadline}
            </p>
            <div
              class="tt-hero-stagger mt-9 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5"
              style="--stagger-delay: 180ms;"
            >
              <a
                href="#waitlist"
                class="tt-btn inline-flex items-center justify-center h-14 px-8 rounded-full bg-[#C8FF00] text-zinc-950 text-base font-semibold hover:bg-[#D8FF42] whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C8FF00] focus-visible:ring-offset-2 focus-visible:ring-offset-[#09090B]"
              >
                {SITE_CONTENT.hero.primaryCta}
              </a>
              <p class="text-base text-zinc-300">
                {SITE_CONTENT.hero.trustMicroCopy}
              </p>
            </div>
          </div>

          <!-- 3D Audio Visualizer + Mini Audio Player + Live Collaboration Card -->
          <div
            class="lg:col-span-6 tt-hero-stagger"
            style="--stagger-delay: 220ms;"
            data-parallax
          >
            <HeroVisualizer client:load />
          </div>
        </div>
      </section>

      <!-- Problem Section (With Signal-Routing Graphic) -->
      <section class="py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80 bg-[#09090B]">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center" data-reveal>
          <div class="lg:col-span-6">
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50 leading-snug">
              {SITE_CONTENT.problem.heading}
            </h2>
            <p class="mt-5 text-lg sm:text-xl text-zinc-300 leading-relaxed">
              {SITE_CONTENT.problem.body}
            </p>

            <ul class="mt-8 divide-y divide-zinc-800/80 border-t border-b border-zinc-800/80">
              {SITE_CONTENT.problem.signals.map((signal) => (
                <li class="py-4 flex items-center justify-between gap-4">
                  <span class="text-base font-semibold text-zinc-100">
                    {signal.label}
                  </span>
                  <span class="text-sm sm:text-base text-zinc-400 text-right">
                    {signal.detail}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-6">
            <div class="tt-card-float bg-[#111115] border border-zinc-800/90 rounded-3xl p-6 sm:p-8">
              <div class="rounded-2xl bg-[#09090B] border border-zinc-800/80 p-5 sm:p-6">
                <svg
                  viewBox="0 0 480 280"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-full h-auto"
                  role="img"
                  aria-label="Diagram comparing scattered social DMs and unverified links against direct audio-first studio matching"
                >
                  <defs>
                    <linearGradient id="tt-signal-grad" x1="40" y1="210" x2="440" y2="210" gradientUnits="userSpaceOnUse">
                      <stop offset="0%" stop-color="#C8FF00" stop-opacity="0.25" />
                      <stop offset="50%" stop-color="#C8FF00" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#C8FF00" stop-opacity="0.4" />
                    </linearGradient>
                  </defs>

                  <!-- Top Half: Scattered Social Inbox Noise -->
                  <rect x="20" y="20" width="440" height="106" rx="16" fill="#111115" stroke="#27272A" />
                  <text x="38" y="46" fill="#A1A1AA" font-size="12" font-family="Inter, sans-serif" font-weight="600">
                    SOCIAL INBOX &amp; SCATTERED LINKS
                  </text>

                  <!-- Disconnected Dashed Nodes -->
                  <rect x="38" y="64" width="110" height="44" rx="10" fill="#18181D" stroke="#3F3F46" />
                  <circle cx="56" cy="86" r="7" fill="#3F3F46" />
                  <rect x="70" y="79" width="60" height="5" rx="2.5" fill="#52525B" />
                  <rect x="70" y="89" width="42" height="4" rx="2" fill="#3F3F46" />

                  <path d="M154 86 C176 68, 184 106, 206 82" stroke="#52525B" stroke-width="1.5" stroke-dasharray="4 4" />
                  <circle cx="180" cy="86" r="10" fill="#18181D" stroke="#52525B" />
                  <path d="M176 82 L184 90 M184 82 L176 90" stroke="#EF4444" stroke-width="1.6" stroke-linecap="round" />

                  <rect x="210" y="64" width="110" height="44" rx="10" fill="#18181D" stroke="#3F3F46" />
                  <rect x="224" y="79" width="76" height="5" rx="2.5" fill="#52525B" />
                  <rect x="224" y="89" width="54" height="4" rx="2" fill="#3F3F46" />

                  <path d="M326 86 L348 86" stroke="#52525B" stroke-width="1.5" stroke-dasharray="4 4" />
                  <rect x="352" y="64" width="90" height="44" rx="10" fill="#18181D" stroke="#3F3F46" opacity="0.65" />
                  <rect x="366" y="79" width="52" height="5" rx="2.5" fill="#3F3F46" />
                  <rect x="366" y="89" width="34" height="4" rx="2" fill="#27272A" />

                  <!-- Bottom Half: Direct Studio Match -->
                  <rect x="20" y="148" width="440" height="112" rx="18" fill="#111115" stroke="#C8FF00" stroke-opacity="0.45" />
                  <text x="38" y="174" fill="#C8FF00" font-size="12" font-family="Inter, sans-serif" font-weight="600">
                    DIRECT AUDIO &amp; INTENT MATCH
                  </text>

                  <!-- Producer Node -->
                  <rect x="38" y="190" width="122" height="52" rx="14" fill="#17171D" stroke="#3F3F46" />
                  <circle cx="62" cy="216" r="12" fill="#27272A" stroke="#C8FF00" stroke-width="1.5" />
                  <rect x="82" y="207" width="60" height="6" rx="3" fill="#F4F4F5" />
                  <rect x="82" y="219" width="44" height="5" rx="2.5" fill="#A1A1AA" />

                  <!-- Acoustic Waveform Bridge -->
                  <path d="M168 216 L312 216" stroke="url(#tt-signal-grad)" stroke-width="2" />
                  <g fill="#C8FF00">
                    <rect x="188" y="207" width="4" height="18" rx="2" />
                    <rect x="198" y="200" width="4" height="32" rx="2" />
                    <rect x="208" y="194" width="4" height="44" rx="2" />
                    <rect x="218" y="203" width="4" height="26" rx="2" />
                    <rect x="228" y="197" width="4" height="38" rx="2" />
                    <rect x="238" y="191" width="4" height="50" rx="2" />
                    <rect x="248" y="202" width="4" height="28" rx="2" />
                    <rect x="258" y="196" width="4" height="40" rx="2" />
                    <rect x="268" y="204" width="4" height="24" rx="2" />
                    <rect x="278" y="199" width="4" height="34" rx="2" />
                    <rect x="288" y="207" width="4" height="18" rx="2" />
                  </g>

                  <!-- Vocalist Node -->
                  <rect x="320" y="190" width="122" height="52" rx="14" fill="#17171D" stroke="#C8FF00" stroke-opacity="0.7" />
                  <circle cx="344" cy="216" r="12" fill="#C8FF00" />
                  <path d="M339 216 L343 220 L350 212" stroke="#09090B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  <rect x="364" y="207" width="60" height="6" rx="3" fill="#F4F4F5" />
                  <rect x="364" y="219" width="48" height="5" rx="2.5" fill="#C8FF00" fill-opacity="0.85" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- How It Works Section (Animated 2D Storyboard Cards) -->
      <section id="how-it-works" class="scroll-mt-20 py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50" data-reveal>
            {SITE_CONTENT.howItWorks.heading}
          </h2>

          <ol class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-7">
            {SITE_CONTENT.howItWorks.steps.map((step, index) => (
              <li
                data-reveal
                style={`--reveal-delay: ${index * 90}ms; --float-delay: ${index * 0.85}s;`}
                class="group tt-card-float tt-float-idle bg-[#111115] border border-zinc-800/90 rounded-3xl p-5 sm:p-6 flex flex-col justify-between gap-5"
              >
                <HowItWorksScenes sceneId={step.id} />

                <div class="flex items-start gap-3.5 px-1 pb-1">
                  <div class="w-9 h-9 rounded-full bg-[#09090B] border border-zinc-800 flex items-center justify-center shrink-0 mt-0.5">
                    {step.id === 'build' && (
                      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <rect x="2" y="8" width="2.5" height="6" rx="1.25" fill="#C8FF00" />
                        <rect x="6.5" y="4" width="2.5" height="12" rx="1.25" fill="#C8FF00" />
                        <rect x="11" y="6" width="2.5" height="8" rx="1.25" fill="#F4F4F5" />
                        <rect x="15.5" y="9" width="2.5" height="4" rx="1.25" fill="#71717A" />
                      </svg>
                    )}
                    {step.id === 'discover' && (
                      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="9" cy="9" r="5.5" stroke="#C8FF00" stroke-width="1.8" />
                        <path d="M13.2 13.2L17 17" stroke="#F4F4F5" stroke-width="1.8" stroke-linecap="round" />
                      </svg>
                    )}
                    {step.id === 'collaborate' && (
                      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="6.5" cy="10" r="3.5" stroke="#C8FF00" stroke-width="1.8" />
                        <circle cx="13.5" cy="10" r="3.5" stroke="#F4F4F5" stroke-width="1.8" />
                      </svg>
                    )}
                  </div>
                  <p class="text-lg text-zinc-200 leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Interactive Portfolio & Reels Mockup Preview -->
      <section id="preview" class="scroll-mt-20 py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80 bg-[#09090B]">
        <div class="max-w-6xl mx-auto" data-reveal>
          <div class="max-w-2xl mb-10">
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50">
              {SITE_CONTENT.preview.heading}
            </h2>
            <p class="mt-3 text-lg text-zinc-300 leading-relaxed">
              {SITE_CONTENT.preview.subheading}
            </p>
          </div>

          <ProductPreview client:load />
        </div>
      </section>

      <!-- Features Grid (4 Floating Cards) -->
      <section id="features" class="scroll-mt-20 py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50 max-w-2xl" data-reveal>
            {SITE_CONTENT.features.heading}
          </h2>

          <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-7">
            {SITE_CONTENT.features.items.map((feature, index) => (
              <article
                data-reveal
                style={`--reveal-delay: ${index * 80}ms; --float-delay: ${index * 0.7}s;`}
                class="tt-card-float tt-float-idle bg-[#111115] border border-zinc-800/90 rounded-3xl p-7 sm:p-9 flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="text-2xl font-semibold text-zinc-50 tracking-tight">
                      {feature.title}
                    </h3>
                    <span class="text-sm font-mono text-zinc-500 tabular-nums shrink-0">
                      0{index + 1}
                    </span>
                  </div>
                  <p class="mt-3.5 text-base sm:text-lg text-zinc-300 leading-relaxed">
                    {feature.description}
                  </p>
                </div>
                <p class="mt-6 pt-4 border-t border-zinc-800/70 text-sm text-zinc-400">
                  {feature.metaLabel}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Waitlist Conversion Form + Founding Pass Graphic -->
      <section id="waitlist" class="scroll-mt-20 py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80 bg-[#09090B]">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-7 items-stretch" data-reveal>
          <!-- Left Visual Founding Member Pass Card -->
          <div class="lg:col-span-5">
            <div class="tt-card-float h-full bg-[#111115] border border-zinc-800/90 rounded-3xl p-6 sm:p-8 flex flex-col justify-between gap-6">
              <div>
                <div class="relative aspect-[4/3] w-full rounded-2xl overflow-hidden bg-[#09090B] border border-zinc-800/80">
                  <!-- SVG fallback canvas behind pass graphic -->
                  <div
                    class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-zinc-900 to-zinc-950"
                    aria-hidden="true"
                  >
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                      <circle cx="32" cy="32" r="24" stroke="#C8FF00" stroke-opacity="0.4" stroke-width="2" />
                      <circle cx="32" cy="32" r="14" stroke="#3F3F46" stroke-width="1.5" />
                    </svg>
                  </div>

                  <img
                    src={STUDIO_ASSETS.foundingStudioPass}
                    alt="TuneTactics metallic studio access pass with acoustic waveform engraving"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="relative z-10 w-full h-full object-cover"
                  />

                  <div
                    class="absolute inset-0 z-20 bg-gradient-to-t from-[#09090B]/90 via-transparent to-transparent"
                    aria-hidden="true"
                  />

                  <div class="absolute bottom-4 left-4 right-4 z-30 flex items-end justify-between gap-3">
                    <div>
                      <p class="text-lg font-bold text-zinc-50" style="font-family: var(--font-display);">
                        {SITE_CONTENT.waitlist.passTitle}
                      </p>
                      <p class="text-sm text-zinc-300">
                        {SITE_CONTENT.waitlist.passSubtitle}
                      </p>
                    </div>
                    <svg
                      width="34"
                      height="34"
                      viewBox="0 0 34 34"
                      fill="none"
                      aria-hidden="true"
                      class="shrink-0"
                    >
                      <circle cx="17" cy="17" r="15.5" fill="#09090B" fill-opacity="0.85" stroke="#C8FF00" />
                      <rect x="9" y="14" width="2.5" height="6" rx="1.25" fill="#C8FF00" />
                      <rect x="13.5" y="10" width="2.5" height="14" rx="1.25" fill="#C8FF00" />
                      <rect x="18" y="12" width="2.5" height="10" rx="1.25" fill="#F4F4F5" />
                      <rect x="22.5" y="15" width="2.5" height="4" rx="1.25" fill="#A1A1AA" />
                    </svg>
                  </div>
                </div>

                <ul class="mt-6 divide-y divide-zinc-800/80">
                  {SITE_CONTENT.waitlist.perks.map((perk) => (
                    <li class="py-4 first:pt-1 last:pb-0 flex items-start gap-3.5">
                      <svg
                        width="20"
                        height="20"
                        viewBox="0 0 20 20"
                        fill="none"
                        aria-hidden="true"
                        class="shrink-0 mt-0.5"
                      >
                        <circle cx="10" cy="10" r="9" fill="#C8FF00" fill-opacity="0.14" stroke="#C8FF00" stroke-opacity="0.6" />
                        <path
                          d="M6.5 10.2L8.8 12.5L13.5 7.5"
                          stroke="#C8FF00"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <div>
                        <p class="text-base font-semibold text-zinc-100">
                          {perk.title}
                        </p>
                        <p class="mt-0.5 text-sm text-zinc-400 leading-relaxed">
                          {perk.detail}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- Right Waitlist Conversion Form -->
          <div class="lg:col-span-7">
            <WaitlistForm client:load />
          </div>
        </div>
      </section>

      <!-- FAQ Accordion -->
      <section id="faq" class="scroll-mt-20 py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80">
        <div class="max-w-3xl mx-auto" data-reveal>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-50 mb-8">
            {SITE_CONTENT.faq.heading}
          </h2>
          <FaqAccordion client:load />
        </div>
      </section>

      <!-- Final CTA Banner -->
      <section class="py-16 sm:py-24 px-4 sm:px-6 border-t border-zinc-800/80 bg-[#09090B]">
        <div
          class="tt-card-float max-w-6xl mx-auto bg-[#111115] border border-zinc-800/90 rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row md:items-center md:justify-between gap-8"
          data-reveal
        >
          <div>
            <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">
              {SITE_CONTENT.finalCta.heading}
            </h2>
            <p class="mt-3 text-lg text-zinc-300">
              {SITE_CONTENT.finalCta.subheading}
            </p>
          </div>
          <div class="shrink-0">
            <a
              href="#waitlist"
              class="tt-btn inline-flex items-center justify-center h-14 px-8 rounded-full bg-[#C8FF00] text-zinc-950 text-base font-semibold hover:bg-[#D8FF42] whitespace-nowrap shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#C8FF00]"
            >
              {SITE_CONTENT.finalCta.buttonLabel}
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800/80 bg-[#09090B] py-10 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <p class="text-lg font-bold text-zinc-100" style="font-family: var(--font-display);">
            {SITE_CONTENT.nav.brand}
          </p>
          <p class="mt-1 text-base text-zinc-400">
            {SITE_CONTENT.footer.tagline}
          </p>
        </div>

        <FooterLinks client:load />
      </div>
    </footer>
  </div>

  <script>
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');

    // 1. Staggered Scroll-Reveal via IntersectionObserver + viewport sweep on scroll
    const revealVisibleInViewport = () => {
      const vh = window.innerHeight || 900;
      revealEls.forEach((el) => {
        if (el.getAttribute('data-reveal') === 'visible') return;
        const rect = el.getBoundingClientRect();
        if (rect.top <= vh + 80 && rect.bottom >= -80) {
          el.setAttribute('data-reveal', 'visible');
        }
      });
    };

    if (prefersReduced || !('IntersectionObserver' in window)) {
      revealEls.forEach((el) => el.setAttribute('data-reveal', 'visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-reveal', 'visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.01, rootMargin: '80px 0px 80px 0px' }
      );
      revealEls.forEach((el) => observer.observe(el));
      revealVisibleInViewport();
    }

    // 2. Scroll Progress Indicator & Gentle Hero Parallax (transform-only, rAF throttled)
    const progressEl = document.querySelector<HTMLElement>('[data-scroll-progress]');
    const parallaxEl = document.querySelector<HTMLElement>('[data-parallax]');
    let scrollRaf = 0;

    const updateScrollEffects = () => {
      scrollRaf = 0;
      const scrollY = window.scrollY;
      const maxScroll = Math.max(
        document.documentElement.scrollHeight - window.innerHeight,
        1
      );
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));

      if (progressEl) {
        progressEl.style.transform = `scaleX(${progress})`;
      }
      if (parallaxEl && !prefersReduced && scrollY < 900) {
        parallaxEl.style.transform = `translate3d(0, ${Math.min(28, scrollY * 0.04)}px, 0)`;
      }
      revealVisibleInViewport();
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!scrollRaf) {
          scrollRaf = window.requestAnimationFrame(updateScrollEffects);
        }
      },
      { passive: true }
    );
    updateScrollEffects();

    // 3. Subtle Trailing Cursor Glow on Desktop Fine Pointers
    const glowEl = document.getElementById('cursor-glow');
    const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (glowEl && isFinePointer && !prefersReduced) {
      let targetX = -999;
      let targetY = -999;
      let currentX = -999;
      let currentY = -999;
      let glowRaf = 0;

      const animateGlow = () => {
        currentX += (targetX - currentX) * 0.16;
        currentY += (targetY - currentY) * 0.16;
        glowEl.style.transform = `translate3d(${currentX - 170}px, ${currentY - 170}px, 0)`;
        if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
          glowRaf = window.requestAnimationFrame(animateGlow);
        } else {
          glowRaf = 0;
        }
      };

      window.addEventListener(
        'pointermove',
        (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
          glowEl.style.opacity = '1';
          if (!glowRaf) {
            glowRaf = window.requestAnimationFrame(animateGlow);
          }
        },
        { passive: true }
      );

      document.addEventListener('mouseleave', () => {
        glowEl.style.opacity = '0';
      });
    }
  </script>
</Layout>
